;;
;; chora-registry_praxis.deed: the registry seed, the hand-edited register of
;; repo identities. sync/parse-repos.sh reads it; sync/export-json.sh
;; generates worker/data from it; scripts/check-registry.sh gates both.
;;
;; Converted once from verisim/seed/repos.a2ml under the single recorded D313
;; exception (owner ruling 2026-11-14), by the mapping
;; standards 1-formats/deed/mappings/registry-seed-to-deed.adoc. Form owned by A1
;; (CHORA-SPEC). Owner rulings of 2026-11-14 on the form: praxis-deed head;
;; clade codes are placements in the named scheme clade-12, a judgement scheme;
;; each repo stores its v8 id and the domain that minted it; completion and
;; julia do not translate.
;;
;; One (repo …) per registered repo. A registered repo is never removed
;; (ADR 0008). Its id is minted once, from its birth path: the path of
;; (former :generation 1 …) when it has moved, else :owner/:name. A move or
;; rename adds a (former …) and changes :owner or :name, never :uuid (U1).
;; :minted-in is gv-clade-index for a repo born before V9 (late registrations
;; under L1 included) and chora-registry for one born after it.
;; (retired …) lists a path whose ids were served and withdrawn (ADR 0007
;; remints); those ids are never minted again.
(praxis-deed
  :schema-version  "1.0.0"
  :canonical-name  "chora-registry-seed"
;; The hyperpolymath estate chora (CHORA-SPEC 9), the registry's birth estate (B1).
  :beholding-chora #uuid"0889b37b-defb-831f-973c-e119500db00e"
  :created         "2026-03-16"
  :total-repos     327

;; The classification scheme the seed's clade codes belong to. judgement, not
;; strict: 144 placements were made by best fit or heuristic and await
;; ratification (owner ruling 2026-11-14). Its categories must match
;; verisim/seed/clades.a2ml (code and name) until that file is converted.
  (scheme :id clade-12 :kind judgement :membership multiple :link see-also
    (category :id fv :name "Formal Verification & Proofs")
    (category :id nl :name "Nextgen Languages")
    (category :id rm :name "Repo Management & Tooling")
    (category :id gv :name "Governance & Standards")
    (category :id db :name "Databases")
    (category :id ap :name "Applications")
    (category :id ix :name "Infrastructure & Cloud")
    (category :id dx :name "Developer Ecosystem")
    (category :id pt :name "Protocols & Interop")
    (category :id ax :name "AI & Neurosymbolic")
    (category :id gm :name "Games & Interactive")
    (category :id sc :name "Security"))


  ;; ============================================================================
  ;; fv — Formal Verification & Proofs
  ;; ============================================================================

  (repo :name "proven" :owner "hyperpolymath"
        :uuid #uuid"b4685b0c-4bd0-8329-b15a-20436c1e8960" :minted-in gv-clade-index
        :description "Formally verified safety library — Idris2 dependent types + Zig FFI + 120+ bindings"
        (lineage :type standalone)
